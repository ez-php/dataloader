{
  "name": "ez-php/dataloader",
  "version": "2.5.1",
  "description": "Generic keyed-batch loading and per-key memoization primitive for solving N+1 access patterns",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["dataloader", "batching", "n-plus-1", "memoization", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/dataloader",
  "support": {
    "issues": "https://github.com/ez-php/dataloader/issues",
    "source": "https://github.com/ez-php/dataloader"
  },
  "require": {
    "php": "^8.5"
  },
  "require-dev": {
    "ez-php/docker": "^2.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\DataLoader\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
